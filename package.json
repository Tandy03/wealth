{
  "name": "investment-tracker",
  "version": "1.0.0",
  "description": "Personal investment portfolio tracker",
  "main": "backend/server.js",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "google-auth": "node backend/scripts/googleAuth.js",
    "test": "node --test --test-concurrency=4 backend/tests/*.test.js",
    "test:ui": "node --test backend/tests/uiSmoke.test.js",
    "lint": "eslint shared frontend/js/state-store.js frontend/js/mobile-api.js frontend/js/data-loader.js frontend/js/api frontend/js/controllers/sync.js frontend/js/forms/settings.js frontend/js/forms/calculators.js frontend/js/renderers/sync.js frontend/js/renderers/dashboard.js frontend/js/renderers/calculators.js frontend/js/analytics frontend/js/cashflow.js frontend/js/market-data.js frontend/js/portfolio",
    "check:frontend": "node backend/scripts/checkFrontendContract.js",
    "proxy:smoke": "node backend/scripts/proxySmoke.js",
    "smoke:serve": "node backend/scripts/uiSmokeServer.js",
    "mobile:config": "node backend/scripts/generateMobileConfig.js",
    "mobile:check": "node backend/scripts/checkMobileReadiness.js",
    "mobile:prepare": "node backend/scripts/prepareMobileAssets.js",
    "capacitor:copy:before": "npm run mobile:prepare",
    "mobile:sync": "npm run mobile:config && npm run mobile:prepare && npx cap sync android",
    "mobile:open": "npx cap open android",
    "mobile:build": "npm run mobile:sync && cd android && gradlew.bat assembleDebug",
    "mobile:apk": "npm run mobile:build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@google-cloud/local-auth": "^3.0.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "googleapis": "^178.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "eslint": "10.13.0",
    "jsdom": "^29.1.1"
  },
  "overrides": {
    "gaxios@6": {
      "uuid": "11.1.1"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
